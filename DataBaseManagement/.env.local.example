# Database Configuration
# Copy this file to .env.local and update with YOUR local settings
# .env.local is gitignored and won't be committed to GitHub

DB_HOST=127.0.0.1
DB_PORT=3306          # ← Change this to YOUR MySQL port (3306, 3307, etc.)
DB_USER=root
DB_PASSWORD=
DB_NAME=skill_service_exchange_db

# Email Configuration (optional)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=skill.exchange.swap@gmail.com
MAIL_PASSWORD=your_password_here
MAIL_FROM=skill.exchange.swap@gmail.com
MAIL_FROM_NAME="Skill Service Exchange"
