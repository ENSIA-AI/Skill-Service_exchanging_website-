# Database Configuration Template
# Copy this file to .env.local and fill in YOUR server's database credentials

# Database Host (usually localhost for shared hosting, or your DB server IP/hostname)
DB_HOST=localhost

# Database Port (usually 3306 for MySQL)
DB_PORT=3306

# Database Username (created in your hosting control panel)
DB_USER=your_db_username

# Database Password (set when creating the database user)
DB_PASSWORD=your_db_password

# Database Name (the database you created for this project)
DB_NAME=your_database_name

# IMPORTANT SETUP INSTRUCTIONS FOR YOUR FRIEND:
# ================================================
# 1. Create a new MySQL database in the hosting control panel
# 2. Create a database user with full privileges on that database
# 3. Copy this file to .env.local
# 4. Replace the placeholder values with your actual credentials:
#    - DB_HOST: Your database host (localhost, IP, or hostname)
#    - DB_USER: Your database username
#    - DB_PASSWORD: Your database password
#    - DB_NAME: Your database name
# 5. Place the database schema (import the provided SQL file)
# 6. Ensure .env.local is NOT committed to git (keep it gitignored)
# 7. Make sure .env.local permissions are restricted (644 or better)

# NOTE: This file (.env.example) serves as documentation only.
# The actual .env.local file should be created on each server
# and should NEVER be committed to version control.
