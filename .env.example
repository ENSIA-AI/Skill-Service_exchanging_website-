# =============================================================
# SMTP EMAIL CONFIGURATION
# =============================================================
# Copy this file to .env and fill in your credentials
# .env is gitignored and will NOT be pushed to the repository
# =============================================================
# 
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Sign up at https://mailtrap.io (FREE)
# 3. Go to: Email Testing → Inboxes → My Inbox → Show Credentials
# 4. Copy your Username and Password below
# 5. Save the file
# =============================================================

# Mailtrap SMTP Settings (recommended for development/testing)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=f48350b60d52a0
SMTP_PASSWORD=91e5ff3262d4c0

# Email Display Settings
SMTP_FROM_EMAIL=noreply@skillserviceexchange.com
SMTP_FROM_NAME=Skill Service Exchange

# Debug Mode (set to false in production)
SMTP_DEBUG=true

# =============================================================
# ALTERNATIVE: Gmail Configuration (for production)
# =============================================================
# Uncomment and use these settings if you want real emails:
# 
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM_EMAIL=your-email@gmail.com
# SMTP_FROM_NAME=Skill Service Exchange
# SMTP_DEBUG=false
# =============================================================

